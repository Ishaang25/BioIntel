# ---------------------------------------------------------------------------
# BioIntel configuration
#
# Copy to `.env` in the repository root. Every value below is optional: the
# application boots with sensible defaults on a laptop with no infrastructure.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=local            # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false               # forced on in staging/production
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Language model --------------------------------------------------------
# Without a key, BioIntel runs its deterministic offline analyser and marks
# every report as degraded. The product works; the analysis is much weaker.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1      # Azure/proxy/self-hosted
# OPENAI_ORGANIZATION=

MODEL_REASONING=gpt-5        # claim extraction, adjudication, report synthesis
MODEL_FAST=gpt-5-mini        # query planning, profile extraction
MODEL_VISION=gpt-5           # charts, diagrams, scanned pages
MODEL_EXTRACTION=gpt-5-mini  # per-chunk entity extraction (recognition, not reasoning)
MODEL_EMBEDDING=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

LLM_REASONING_EFFORT=medium  # minimal | low | medium | high
LLM_EXTRACTION_REASONING_EFFORT=low   # per-chunk extraction; effort buys latency, not recall
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=4
# Ceiling on one response, reasoning tokens included. Must clear a real answer
# plus the model's reasoning; chunk size is what bounds normal output.
LLM_MAX_OUTPUT_TOKENS=32000
LLM_CONCURRENCY=12
LLM_MAX_CALLS_PER_RUN=400    # hard cost ceiling per analysis

# --- Per-call budgets ------------------------------------------------------
# A single call carrying a whole 50-page deck is slow, expensive and produces
# an answer too long for the output window, which comes back as invalid JSON.
# These keep every call small; `python -m app.scripts.profile_run` shows the
# result per stage.
LLM_MAX_INPUT_TOKENS=20000        # warn above this; extraction stages hard-fail
EXTRACTION_CHUNK_INPUT_TOKENS=12000
EXTRACTION_CHUNK_MAX_PAGES=8      # pages per extraction call
EXTRACTION_CHUNK_OUTPUT_TOKENS=6000
VISION_MAX_OUTPUT_TOKENS=6000
# Page reading is mostly perception. Raise to "medium" if chart-value recovery
# on dense figures matters more than turnaround time.
VISION_REASONING_EFFORT=low

# --- Database --------------------------------------------------------------
# Defaults to SQLite under STORAGE_DIR. Use PostgreSQL for anything shared.
# A `postgres://` or `postgresql://` URL -- what Neon, Render, Supabase and
# Heroku hand out -- is rewritten onto the psycopg 3 driver automatically, so
# a provider's connection string can be pasted in unmodified.
# DATABASE_URL=postgresql+psycopg://biointel:biointel@localhost:5432/biointel
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Storage ---------------------------------------------------------------
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=400

# --- Literature retrieval --------------------------------------------------
RETRIEVAL_ENABLED=true
# An NCBI key raises the PubMed rate limit from 3 to 10 requests/second.
# Free: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_TOOL_EMAIL=engineering@example.com
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_CONCURRENCY=4
RETRIEVAL_PAGE_SIZE=25
EVIDENCE_PER_CLAIM=8
RETRIEVAL_CACHE_TTL_HOURS=168

# --- Jobs ------------------------------------------------------------------
# worker: run `biointel-worker` alongside the API (production).
# inline: the API process runs analyses in a background thread (single user).
JOB_EXECUTION_MODE=worker
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=300

# --- Deployment ------------------------------------------------------------
# Container-only. When true the entrypoint runs `alembic upgrade head` before
# starting. Deployed environments do not create their schema on boot, so this
# is how platforms without a release hook get migrated. docker-compose leaves
# it off: it runs a dedicated `migrate` service instead.
# RUN_MIGRATIONS=false
# Bound by the container command; platforms that assign a port inject it.
# PORT=8000

# --- Security --------------------------------------------------------------
# Comma-separated API keys. Empty disables auth, which is refused in production.
API_KEYS=
SECRET_KEY=dev-insecure-secret-change-me
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_HOUR=30

# --- Frontend --------------------------------------------------------------
BIOINTEL_API_URL=http://127.0.0.1:8000
# Must match one of API_KEYS when auth is enabled; stays server-side only.
BIOINTEL_API_KEY=
